repository-code: "https://github.com/ai4-film/aps-standard"
url: "https://ai4.film"
license: Apache-2.0
# Reflects the most recently published version. Bump on release, not on merge.
version: "1.0.2"
date-released: "2026-09-11"
keywords:
  - AI
  - film production
  - provenance
  - chain of title
  - AI disclosure
  - audiovisual
# Concept DOI: covers all versions and resolves to the most recent one. The DOI of a
